{
  "realm": "incidents-realm",
  "enabled": true,
  "displayName": "Incidents Management",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 3600,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      { "name": "ADMIN",      "description": "Administrateur de la plateforme" },
      { "name": "TECHNICIEN", "description": "Technicien support" },
      { "name": "USER",       "description": "Utilisateur standard" }
    ]
  },
  "clients": [
    {
      "clientId": "incidents-gateway",
      "name": "API Gateway Client",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "secret": "incidents-gateway-secret",
      "redirectUris": [
        "http://localhost:8880/*",
        "http://localhost:3000/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:4200",
        "http://localhost:8880"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ]
    },
    {
      "clientId": "incidents-client",
      "name": "Client Portal SPA",
      "description": "Public SPA for standard users - Support IA and incident tracking",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    },
    {
      "clientId": "incidents-admin",
      "name": "Admin Dashboard SPA",
      "description": "Public SPA for admins and technicians - Full incident management",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@incidents.local",
      "firstName": "Admin",
      "lastName": "System",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN", "USER"]
    },
    {
      "username": "technicien1",
      "email": "tech@incidents.local",
      "firstName": "Technicien",
      "lastName": "Support",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "tech123",
          "temporary": false
        }
      ],
      "realmRoles": ["TECHNICIEN", "USER"]
    },
    {
      "username": "user1",
      "email": "user@incidents.local",
      "firstName": "User",
      "lastName": "Normal",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "user123",
          "temporary": false
        }
      ],
      "realmRoles": ["USER"]
    }
  ],
  "scopeMappings": [],
  "clientScopeMappings": {}
}
